# Server Port Configuration
PORT=3000

# Secret Key for Client Applications Authentication (API Secret)
APP_SECRET=your_app_secret_here

# Allowed App IDs permitted to call the API Gateway (comma-separated)
ALLOWED_APP_IDS=App1,App2,Aplikasi_TokoA,Aplikasi_TokoB

# GoPay Static QRIS String from GoBiz App / Printout (Dapatkan dari aplikasi GoBiz / Cetakan QRIS toko Anda)
GOPAY_STATIC_QRIS=YOUR_GOPAY_STATIC_QRIS_STRING_HERE

# GoPay Merchant ID
GOPAY_MERCHANT_ID=G844728303

# Unique Code Settings for Payment Reconciler (1 - 99 Rp)
ENABLE_UNIQUE_CODE=true
MIN_UNIQUE_CODE=1
MAX_UNIQUE_CODE=99

# Password for Admin Portal Control Panel Login (/login)
ADMIN_PASSWORD=your_admin_password_here

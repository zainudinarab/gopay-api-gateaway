# Server Port Configuration
PORT=3000

# Secret Key for Client Applications Authentication (API Secret)
APP_SECRET=your_app_secret_here

# Allowed App IDs permitted to call the API Gateway (comma-separated)
ALLOWED_APP_IDS=App1,App2,Aplikasi_TokoA,Aplikasi_TokoB

# GoPay Static QRIS String from GoBiz App / Printout
GOPAY_STATIC_QRIS=00020101021126610014COM.GO-JEK.WWW01189360...

# GoPay Merchant ID
GOPAY_MERCHANT_ID=G844728303

# Unique Code Settings for Payment Reconciler (1 - 99 Rp)
ENABLE_UNIQUE_CODE=true
MIN_UNIQUE_CODE=1
MAX_UNIQUE_CODE=99

# Password for Admin Portal Control Panel Login (/login)
ADMIN_PASSWORD=your_admin_password_here

# Database Configuration Options (Choices: sqlite or postgres)
DB_TYPE=postgres
DB_HOST=postgres_db
DB_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=gopay_gateway
# DATABASE_URL=postgres://postgres:password@localhost:5432/gopay_gateway
